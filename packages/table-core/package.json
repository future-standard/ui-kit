{
  "name": "@future-standard-ui/table-core",
  "version": "0.0.0",
  "description": "Framework-free table engine: schema, state, row model and DOM contract.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --emitDeclarationOnly",
    "test": "vitest run"
  },
  "devDependencies": {
    "@future-standard-ui/build-config": "workspace:*",
    "typescript": "5.9.3",
    "vite": "8.0.0",
    "vitest": "4.1.11"
  }
}
